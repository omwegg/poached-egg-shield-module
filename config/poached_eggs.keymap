#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        // "00"（KP_N0 を 2 回送る）numpad 用マクロ
        num_00: num_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_N0 &kp KP_N0>;
        };

        // BT プロファイル切替と OS モード（mac レイヤー）を連動させる。
        // 接続先を変える＝仮想デスクトップ切替キーの送出内容も切り替わる。
        prof0_mac: prof0_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 5>;
        };
        prof1_win: prof1_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 0>;
        };

        // 仮想デスクトップ切替。&kp LC(LG(X)) 形式の implicit modifier は ZMK 内で
        // グローバルに 1 つの状態として持たれ、zmk_hid_implicit_modifiers_release()
        // が「どのキーが立てたか」を区別せず一括クリアする（hid_listener.c 参照）。
        // そのため他キーと重なると Ctrl だけ抜けた report が出て Win+←/→
        // （Aero Snap = ウィンドウが左右に寄る）になることがある。
        // macro で修飾キーを explicit modifier として押すと、このキーの押下に
        // 紐付いて refcount 管理されるため他キーの離しで落ちない。
        // pause_for_release で押しっぱなし中は保持し、長押しリピートも維持する。
        // 離す順は キー → 修飾キー（修飾が先に抜けた瞬間の誤爆を防ぐ）。
        win_desk_prev: win_desk_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            bindings
                = <&macro_press &kp LCTRL &kp LGUI &kp LEFT>
                , <&macro_pause_for_release>
                , <&macro_release &kp LEFT &kp LGUI &kp LCTRL>;
        };
        win_desk_next: win_desk_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            bindings
                = <&macro_press &kp LCTRL &kp LGUI &kp RIGHT>
                , <&macro_pause_for_release>
                , <&macro_release &kp RIGHT &kp LGUI &kp LCTRL>;
        };
        mac_desk_prev: mac_desk_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            bindings
                = <&macro_press &kp LCTRL &kp LEFT>
                , <&macro_pause_for_release>
                , <&macro_release &kp LEFT &kp LCTRL>;
        };
        mac_desk_next: mac_desk_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            bindings
                = <&macro_press &kp LCTRL &kp RIGHT>
                , <&macro_pause_for_release>
                , <&macro_release &kp RIGHT &kp LCTRL>;
        };

        // combo 用（一覧表示）。こちらも同じ理由で explicit modifier にする。
        // 取りこぼすと素の Tab が入力されてしまうため。押し切りで良いので tap。
        win_taskview: win_taskview {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp TAB>
                , <&macro_release &kp LGUI>;
        };
        mac_mission: mac_mission {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp UP>
                , <&macro_release &kp LCTRL>;
        };
    };

    // base 最下段の左下ペア(index 37/38)同時押しでデスクトップ一覧を出す。
    // combo は 1 個につき出力が 1 つなので Win/Mac で別定義し、layers で排他にする。
    // ZMK は「最上位のアクティブレイヤー」1 つだけで combo の発火判定をするため
    // （combo.c: setup_candidates_for_first_keypress → zmk_keymap_highest_layer_active）
    // Mac モード(layer 5)では win 側は候補に入らず、二重発火しない。
    // win 側に 4 を含めるのは Num トグル中も Mac 側(5 > 4)と挙動を揃えるため。
    combos {
        compatible = "zmk,combos";

        combo_overview_win {
            timeout-ms = <50>;
            key-positions = <37 38>;
            bindings = <&win_taskview>;   // Windows タスクビュー
            layers = <0 4>;
        };
        combo_overview_mac {
            timeout-ms = <50>;
            key-positions = <37 38>;
            bindings = <&mac_mission>;    // macOS Mission Control
            layers = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R     &kp T                      &kp Y  &kp U     &kp I      &kp O    &kp P     &kp MINUS
&kp LCTRL  &kp A  &kp S  &kp D     &kp F     &kp G                      &kp H  &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V     &kp B                      &kp N  &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&caps_word &win_desk_prev    &win_desk_next     &kp LGUI  &kp LALT  &mo 1  &kp SPACE  &kp RET  &mo 2  &kp BSPC  &kp RGUI  &none  &none  &tog 4
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp ESC    &kp N1    &kp N2  &kp N3    &kp N4      &kp N5                      &kp N6     &kp N7    &kp N8     &kp N9          &kp N0           &kp GRAVE
&kp GRAVE  &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT                   &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR        &kp RPAR         &kp TILDE
&kp RET    &none     &none   &none     &none       &none                       &none      &none     &none      &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE
&none      &none     &none   &trans    &trans      &trans     &kp DEL  &trans  &mo 3      &trans    &trans     &none           &none            &none
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                   &kp F7    &kp F8     &kp F9     &kp F10   &kp F11    &kp F12
&none   &none   &none   &none   &none   &none                    &none     &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &none
&none   &none   &none   &none   &none   &none                    &kp PLUS  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT   &kp BSLH
&none   &none   &none   &trans  &trans  &mo 3   &trans  &kp DEL  &trans    &trans     &trans     &none     &none      &none
            >;
        };

        bt_layer {
            display-name = "BT";
            bindings = <
&bt BT_CLR      &prof0_mac  &prof1_win  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &none  &none  &none  &none  &none  &none
&studio_unlock  &to 0       &to 5       &none         &none         &none                           &none  &none  &none  &none  &none  &none
&none           &none       &none       &none         &none         &none                           &none  &none  &none  &none  &none  &none
&kp O           &kp M       &kp U       &none         &none         &none             &none  &none  &none  &none  &none  &kp K  &kp E  &kp N
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                       &kp KP_DIVIDE    &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &kp KP_EQUAL     &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RET  &none  &kp BSPC  &kp KP_N0  &num_00  &kp COMMA  &trans
            >;
        };

        // Mac モード。base の仮想デスクトップ切替キー(index 37/38)だけ上書きし、
        // 他は全て &trans なので Lower/Raise/Num は素通しで従来通り動く。
        // ★このレイヤーは必ず最後に置くこと（途中に挿すと &mo 1/2/3・&tog 4 がずれる）
        mac_layer {
            display-name = "Mac";
            bindings = <
&trans  &trans        &trans         &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans         &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans         &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mac_desk_prev &mac_desk_next  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
